tracepoint:sched:sched_process_exec /comm == "firecracker" || comm == "cloud-hyperviso"/ { @vmm = pid; printf("EV exec %lld\n", nsecs); }
tracepoint:kvm:kvm_exit /pid == @vmm/ { printf("X %lld %u %lx %lx\n", nsecs, args->exit_reason, args->guest_rip, args->info2); }
tracepoint:kvm:kvm_pio /pid == @vmm && (args->port == 0x80 || args->port == 0x3f0) && args->rw == 1/ { printf("EV pio_%x_%x %lld\n", args->port, args->val, nsecs); }
